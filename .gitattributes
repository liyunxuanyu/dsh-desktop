# Windows batch files are read by cmd.exe, which is line-oriented: a label on an
# LF-only file can be missed. Keep them CRLF in the checkout.
*.cmd text eol=crlf
* text=auto eol=lf
patches/*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
.yarn/patches/*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
